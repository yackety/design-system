      "tabs-bg": "var(--surface-glass)",
      "tabs-pad": "5px",
      "tabs-border": "0 solid transparent",
      "tab-radius": "calc(var(--radius-md) - 1px)",
      "tab-active-bg": "var(--primary-fill)",
      "tab-active-fg": "var(--primary-fg)",
      "tab-indicator": "transparent",
      "nav-active-bg": "var(--surface-3)",
      "nav-active-fg": "var(--fg)",
      "nav-active-shadow": "inset 0 1px 0 var(--rim), inset 0 0 0 1px var(--border)",
      "table-head-bg": "transparent",
      "badge-radius": "var(--radius-full)"
