      "topbar-bg": "color-mix(in srgb, var(--surface) 92%, transparent)",
      "topbar-radius": "0px",
      "topbar-border": "1px solid var(--border)",
      "topbar-shadow": "none",
      "card-bg": "var(--surface)",
      "card-border": "1px solid var(--border)",
      "card-shadow": "var(--shadow-sm)",
