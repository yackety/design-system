      "topbar-radius": "var(--radius-lg)",
      "topbar-border": "0 solid transparent",
      "topbar-shadow": "inset 0 1px 0 var(--rim), inset 0 0 0 1px var(--rim-2), var(--shadow-sm)",
      "card-bg": "var(--surface)",
      "card-border": "0 solid transparent",
      "card-shadow": "inset 0 1px 0 var(--rim), inset 0 0 0 1px var(--rim-2), var(--shadow-sm)",
      "card-glass-bg": "var(--surface-glass)",
      "btn-bg": "var(--surface-2)",
      "btn-border": "var(--border-strong)",
      "btn-primary-shadow": "inset 0 1px 0 #ffffff59, 0 10px 24px -12px var(--glow)",
